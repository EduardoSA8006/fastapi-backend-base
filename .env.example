# Configurações da aplicação
APP_NAME="ClassUp Backend"
DEBUG=false
API_V1_PREFIX="/api/v1"

# Banco de dados
# Desenvolvimento local sem Docker (SQLite):
# DATABASE_URL="sqlite:///./classup.db"
# Docker / PostgreSQL:
DATABASE_URL="postgresql+psycopg://classup:classup@db:5432/classup"

# Credenciais do PostgreSQL (usadas pelo docker-compose)
POSTGRES_USER=classup
POSTGRES_PASSWORD=classup
POSTGRES_DB=classup

# --- Segurança ---
# Rate limit
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT="100/minute"
# Local sem Docker use memory://; no Docker, o compose injeta redis://redis:6379/0
RATE_LIMIT_STORAGE_URI="memory://"

# CORS (formato JSON). NÃO use credentials=true com origins=["*"].
CORS_ALLOW_ORIGINS=[]
CORS_ALLOW_CREDENTIALS=false

# Trusted hosts (formato JSON).
# PRODUÇÃO: defina os hosts reais (ex.: ["api.classup.com"]).
# O valor padrão ["*"] desativa a validação de Host — use apenas em dev.
TRUSTED_HOSTS=["*"]

# Limite de corpo da requisição (bytes)
MAX_BODY_SIZE=1048576

# Headers / proxy
# HSTS só sob HTTPS. TRUST_PROXY=true APENAS atrás de um proxy reverso confiável
# (o rate-limit usará o IP mais à direita de X-Forwarded-For).
HSTS_ENABLED=false
TRUST_PROXY=false
