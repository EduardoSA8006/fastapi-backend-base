# Configurações da aplicação
APP_NAME="ClassUp Backend"
DEBUG=false
API_V1_PREFIX="/api/v1"

# Banco de dados
# Desenvolvimento local sem Docker (SQLite):
# DATABASE_URL="sqlite:///./classup.db"
# Docker / PostgreSQL:
DATABASE_URL="postgresql+psycopg://classup:classup@db:5432/classup"
# Produção (banco externo/gerenciado): exija TLS com sslmode=require, ex.:
# DATABASE_URL="postgresql+psycopg://usuario:senha@host:5432/classup?sslmode=require"

# Credenciais do PostgreSQL (usadas pelo docker-compose)
# PRODUÇÃO: use senha forte — o boot é recusado com senhas default/fracas
# (classup, postgres, password, changeme, admin, vazia).
POSTGRES_USER=classup
POSTGRES_PASSWORD=classup
POSTGRES_DB=classup

# Senha do Redis (usada pelo docker-compose; o Redis sobe com --requirepass).
# PRODUÇÃO: defina uma senha forte.
REDIS_PASSWORD=classup

# --- MinIO (armazenamento de objetos, rede interna do Docker) ---
# O MinIO sobe SEM porta publicada (igual ao Redis/Postgres): só o backend fala
# com ele, via o hostname `minio`. O conteúdo é servido pelo proxy do FastAPI —
# nunca exponha presigned URL a um cliente público. ENDPOINT é host:port (sem
# scheme); USE_SSL=false é texto puro, aceitável na rede interna do mesmo host.
# PRODUÇÃO: senha forte obrigatória — o boot é recusado com default/fraca/ausente
# (classup, postgres, password, changeme, admin, vazia). O usuário também precisa
# ser não-óbvio (boot recusa classup/minio/admin/root/minioadmin). Prefira Docker
# secrets para a credencial.
MINIO_ENDPOINT=minio:9000
MINIO_USE_SSL=false
MINIO_ROOT_USER=classup
MINIO_ROOT_PASSWORD=classup
MINIO_BUCKET=classup-files

# --- Celery (fila de tarefas, rede interna do Docker) ---
# Broker e result backend numa instância Redis DEDICADA (redis-celery), sem
# porta publicada — SEPARADA do Redis do rate-limit. Worker/beat não têm rota
# de rede até o Redis do rate-limit (segmentação no docker-compose).
# PRODUÇÃO (boot recusado se violar): senha forte obrigatória; scheme deve ser
# redis:// ou rediss://; broker/backend NÃO podem apontar para a mesma
# instância (host:porta) do RATE_LIMIT_STORAGE_URI.
# Os defaults abaixo valem para o compose; fora do Docker, ajuste o hostname.
CELERY_REDIS_PASSWORD=classup
CELERY_BROKER_URL="redis://:classup@redis-celery:6379/0"
CELERY_RESULT_BACKEND="redis://:classup@redis-celery:6379/1"

# --- Segurança ---
# Ambiente: development | staging | production (valores fora dessa lista FALHAM
# o boot — fail-closed contra typos que cairiam em modo dev silenciosamente).
# Em production, a aplicação FALHA ao iniciar se: TRUSTED_HOSTS contém "*",
# RATE_LIMIT_STORAGE_URI é memory://, DEBUG=true, a senha do banco, do Redis,
# do MinIO OU do Celery for default/fraca/ausente, ou o broker do Celery
# compartilhar a instância do Redis do rate-limit. Além disso, /docs, /redoc e
# /openapi.json ficam desligados.
ENVIRONMENT=development

# Rate limit
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT="100/minute"
# Local sem Docker use memory://; no Docker, o compose injeta redis://redis:6379/0
RATE_LIMIT_STORAGE_URI="memory://"

# CORS (formato JSON). NÃO use credentials=true com origins=["*"].
CORS_ALLOW_ORIGINS=[]
CORS_ALLOW_CREDENTIALS=false

# Trusted hosts (formato JSON).
# PRODUÇÃO: defina os hosts reais (ex.: ["api.classup.com"]).
# O valor padrão ["*"] desativa a validação de Host — use apenas em dev.
TRUSTED_HOSTS=["*"]

# Limite de corpo da requisição (bytes)
# ATENÇÃO À MEMÓRIA: requisições sem Content-Length (chunked) são bufferizadas
# em memória até este limite antes de chegar ao handler. Pico ~= MAX_BODY_SIZE ×
# requisições chunked concorrentes. Mantenha MAX_BODY_SIZE × --limit-concurrency
# bem abaixo do mem_limit do container (default 1 MB × 100 = ~100 MB < 512m).
# Para uploads grandes, prefira streaming ao storage em vez de elevar este valor.
MAX_BODY_SIZE=1048576

# Headers / proxy
# HSTS só sob HTTPS. TRUST_PROXY=true APENAS atrás de proxy(ies) reverso(s) que
# reescrevam X-Forwarded-For — caso contrário o cliente controla o valor e burla
# o rate-limit. NUM_TRUSTED_PROXIES = quantos proxies confiáveis há à frente
# (ex.: LB + nginx = 2); o IP do cliente é extraído contando esses saltos a
# partir da direita do X-Forwarded-For.
HSTS_ENABLED=false
TRUST_PROXY=false
NUM_TRUSTED_PROXIES=1

# Observabilidade / privacidade: IP do cliente é dado pessoal (LGPD/GDPR).
# Defina false para não registrar o IP nos logs de acesso.
LOG_CLIENT_IP=true

# Migrações no boot do container (dev). Em produção com várias réplicas, use
# false e rode a migração como etapa separada de deploy.
RUN_MIGRATIONS_ON_START=true

# Host enviado pelo healthcheck do container (header Host). O default 127.0.0.1
# funciona em dev (TRUSTED_HOSTS=["*"]). PRODUÇÃO: com TRUSTED_HOSTS restrito,
# defina um host permitido (ex.: api.classup.com), senão o probe recebe 400 e o
# container entra em restart loop.
HEALTHCHECK_HOST=127.0.0.1

# Interface em que a porta da API é publicada pelo docker-compose. Default
# 127.0.0.1 (loopback) NÃO expõe a app em todas as interfaces — evita acesso
# direto contornando o proxy (com TRUST_PROXY=true, isso furaria o rate-limit
# via X-Forwarded-For forjado). Em produção, prefira NÃO publicar a porta
# (exponha só o proxy). Use 0.0.0.0 só conscientemente, p/ acesso na LAN em dev.
API_BIND=127.0.0.1
API_PORT=8001
